{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GoServ: Dev",
      "dependsOn": [
        "GoServ: DB",
        "GoServ: Backend",
        "GoServ: Client",
        "GoServ: Admin"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "GoServ: DB",
      "type": "shell",
      "command": "npm run db:up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GoServ: Backend",
      "type": "shell",
      "command": "dotnet run --launch-profile http",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GoServ: Client",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GoServ: Admin",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/admin"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
